{
  "name": "experiment-tracker",
  "version": "1.0.0",
  "description": "Product Feature Experiment Tracking Dashboard",
  "main": "src/backend/server.ts",
  "scripts": {
    "dev:backend": "ts-node src/backend/server.ts",
    "dev:frontend": "react-scripts start",
    "build:backend": "tsc",
    "build:frontend": "react-scripts build",
    "build": "npm run build:backend && npm run build:frontend",
    "test": "jest",
    "start": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\""
  },
  "keywords": ["experiment", "tracking", "dashboard", "react", "express"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.0.0",
    "cors": "^2.8.5",
    "body-parser": "^1.20.2",
    "dotenv": "^16.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.10.0",
    "axios": "^1.4.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^18.15.11",
    "@types/react": "^18.0.35",
    "@types/react-dom": "^18.0.11",
    "@types/cors": "^2.8.13",
    "typescript": "^5.0.4",
    "ts-node": "^10.9.1",
    "jest": "^29.5.0",
    "@types/jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "concurrently": "^8.0.1",
    "react-scripts": "^5.0.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
