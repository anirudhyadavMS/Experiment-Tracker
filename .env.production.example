# Production Environment Variables (for Azure)
# Copy these to your Azure App Service Configuration > Application Settings

# Server Configuration
PORT=8080
NODE_ENV=production

# Database - Azure Cosmos DB with MongoDB API
# Format: mongodb://<account-name>:<password>@<account-name>.mongo.cosmos.azure.com:10255/<database>?ssl=true&replicaSet=globaldb&retrywrites=false&maxIdleTimeMS=120000
MONGODB_URI=your-cosmos-db-connection-string-here

# Frontend (leave as relative path in production)
REACT_APP_API_URL=/api
